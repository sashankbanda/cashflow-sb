# Copy to .env and fill in. Never commit .env. See docs/RUNBOOK.md for details.

# --- Required ---

# Neon PostgreSQL — use the pooled connection string from the Neon dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Better Auth — 32+ char random secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# The app origin (http://localhost:3000 in dev; the production URL in prod).
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (primary sign-in). Register the redirect URI
# <BETTER_AUTH_URL>/api/auth/callback/google in Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Recommended ---

# Upstash Redis — durable rate limiting (in-memory per-instance fallback if unset).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Bearer secret for the daily recurring-expense cron (/api/cron/recurring).
CRON_SECRET=""

# --- Feature-gated (the feature no-ops until its key is present) ---

# Vercel Blob — receipt attachments.
BLOB_READ_WRITE_TOKEN=""

# Web Push (VAPID). Generate:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Error tracking DSN (Sentry-compatible; wired in src/instrumentation.ts).
SENTRY_DSN=""
